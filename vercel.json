{
  "framework": "nextjs",
  "buildCommand": "prisma generate && (prisma migrate deploy || true) && next build --webpack",
  "crons": [
    {
      "path": "/api/v1/webhooks/dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/cron",
      "schedule": "* * * * *"
    }
  ]
}
